api_id=
api_hash=

# Необязательно: папка чатов Telegram (имя как в клиенте).
# Если переменной/папки нет или она пустая, lnl загрузит все реальные диалоги.
# TG_FOLDER=LNL

# Без этих переменных всё работает как раньше: default → ./lnl.session.
# Для нескольких аккаунтов раскомментируй:
# TG_SESSIONS=default,work
# TG_DEFAULT_SESSION=default
# TG_SESSION_DIR=.
#
# У каждой сессии можно переопределить папку и файл:
# TG_SESSION_WORK_FOLDER=Support
# TG_SESSION_WORK_FILE=lnl.work.session
#
# TG_SESSION_FILE переопределяет старый ./lnl.session для id=default.
# Один session-файл нельзя одновременно использовать в двух процессах lnl.

# HTTP + WS (Android клиент).
LNL_BIND=0.0.0.0:8080

# Защищённая панель аккаунтов и веб-клиент.
# Слушает только loopback; для VPS используй SSH tunnel.
# LNL_DEBUG_UI=1
# LNL_ADMIN_BIND=127.0.0.1:8081
# LNL_ADMIN_TOKEN=replace-with-at-least-32-random-bytes


# Вариант A — lnl на VPS: оба пусто, прямой выход к Telegram.
# Вариант B — с домашнего ПК: SOCKS5 на том же VPS (не MTProxy-ссылка).
# TG_SOCKS5="wires.yufu.su:1080"

# Вариант C — MTProxy FakeTLS (ee), ссылка как в Telegram.
# Патч в vendor/ чинит FakeTLS (timestamp XOR + ServerHello + Obfuscated2).
# TG_PROXY_LINK="https://t.me/proxy?server=HOST&port=PORT&secret=..."
