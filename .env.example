api_id=
api_hash=

# Папка чатов Telegram (имя как в клиенте). Только её грузим.
TG_FOLDER=LNL

# HTTP + WS (Android клиент). Веб-отладка: LNL_DEBUG_UI=1
LNL_BIND=0.0.0.0:8080
# LNL_DEBUG_UI=1


# Вариант A — lnl на VPS: оба пусто, прямой выход к Telegram.
# Вариант B — с домашнего ПК: SOCKS5 на том же VPS (не MTProxy-ссылка).
# TG_SOCKS5="wires.yufu.su:1080"

# Вариант C — MTProxy FakeTLS (ee), ссылка как в Telegram.
# Патч в vendor/ чинит FakeTLS (timestamp XOR + ServerHello + Obfuscated2).
# TG_PROXY_LINK="https://t.me/proxy?server=HOST&port=PORT&secret=..."
